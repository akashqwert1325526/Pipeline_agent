# AI Provider (mock, openai, google)
AI_PROVIDER=mock

# OpenAI API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini API Key (required if AI_PROVIDER=google)
GOOGLE_API_KEY=

# GitHub Personal Access Token (optional, for GitHub integration)
GITHUB_TOKEN=

# Database and storage (defaults work for local dev)
DATABASE_URL=sqlite+aiosqlite:///./pipelinemedic.db
CHROMA_PERSIST_DIR=./chroma_db
